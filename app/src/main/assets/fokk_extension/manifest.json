{
  "manifest_version": 2,
  "name": "Fokk AdShield Filter",
  "version": "1.0",
  "description": "Fokk built-in ad defusers and cosmetic blocker",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["inject_adshield.js", "adblock_defusers.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "permissions": [
    "<all_urls>"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "adshield@fokk.internal"
    }
  }
}
