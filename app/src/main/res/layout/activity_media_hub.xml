<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <FrameLayout
        android:id="@+id/mainContentLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Pull down at the top of a page to reload it. Full-bleed 100% viewport. -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Dual-Deck Multi-Tab Viewport Frame Container -->
            <LinearLayout
                android:id="@+id/dualDeckContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/tabContainer"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- Dual-Deck Split Divider -->
                <LinearLayout
                    android:id="@+id/splitDivider"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:background="#162238"
                    android:gravity="center"
                    android:visibility="gone">

                    <View
                        android:layout_width="48dp"
                        android:layout_height="4dp"
                        android:background="@drawable/bg_stat_chip" />
                </LinearLayout>

                <!-- Secondary Split Viewport Frame -->
                <FrameLayout
                    android:id="@+id/tabContainerSecondary"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_gravity="top"
            android:max="100"
            android:progressTint="@color/fokk_cyan"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Modern Cyber Floating Command Input Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="10dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_floating_command_bar"
        android:elevation="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <ImageView
                android:id="@+id/imgEngineIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_engine_google"
                android:contentDescription="Search engine and site security" />

            <EditText
                android:id="@+id/urlInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="4dp"
                android:background="@null"
                android:hint="Search or enter address"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="13sp" />

            <ImageButton
                android:id="@+id/btnPaywallMirror"
                android:layout_width="30dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_unblock"
                app:tint="#10B981"
                android:visibility="gone"
                android:contentDescription="Mirror paywall view" />

            <ImageButton
                android:id="@+id/btnReaderMode"
                android:layout_width="30dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_reader"
                app:tint="@color/fokk_cyan"
                android:visibility="gone"
                android:contentDescription="Reader view" />

            <ImageButton
                android:id="@+id/btnAiSummary"
                android:layout_width="30dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_sparkle"
                app:tint="@color/fokk_cyan"
                android:visibility="gone"
                android:contentDescription="AI Page summary" />

            <ImageButton
                android:id="@+id/btnClearUrl"
                android:layout_width="30dp"
                android:layout_height="38dp"
                android:layout_marginEnd="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                app:tint="@color/text_secondary"
                android:visibility="gone"
                android:contentDescription="Clear address" />

            <ImageButton
                android:id="@+id/btnVoiceSearch"
                android:layout_width="30dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_mic"
                app:tint="@color/text_secondary"
                android:contentDescription="Voice search" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/btnNavTabs"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_tab_counter"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Open tabs">

            <TextView
                android:id="@+id/textTabCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="1"
                android:textColor="@color/fokk_cyan"
                android:textSize="12sp"
                android:textStyle="bold" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/btnNavMenu"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/text_primary"
            android:contentDescription="Browser menu" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone" />

    <!-- Top 10 Recent Browsing History Dropdown Overlay -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSuggestions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="76dp"
        android:visibility="gone"
        app:cardBackgroundColor="#131B2B"
        app:cardCornerRadius="18dp"
        app:cardElevation="16dp"
        app:strokeColor="#24344D"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Firefox-Style Search Engine Quick Switcher Strip -->
            <LinearLayout
                android:id="@+id/layoutEngineQuickSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SEARCH WITH"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Ecosia -->
                    <FrameLayout
                        android:id="@+id/btnQuickEngineEcosia"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Search with Ecosia">

                        <ImageView
                            android:id="@+id/imgQuickEngineEcosia"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_engine_ecosia" />
                    </FrameLayout>

                    <!-- Google -->
                    <FrameLayout
                        android:id="@+id/btnQuickEngineGoogle"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Search with Google">

                        <ImageView
                            android:id="@+id/imgQuickEngineGoogle"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_engine_google" />
                    </FrameLayout>

                    <!-- DuckDuckGo -->
                    <FrameLayout
                        android:id="@+id/btnQuickEngineDuckDuckGo"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Search with DuckDuckGo">

                        <ImageView
                            android:id="@+id/imgQuickEngineDuckDuckGo"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_engine_duckduckgo" />
                    </FrameLayout>

                    <!-- Brave -->
                    <FrameLayout
                        android:id="@+id/btnQuickEngineBrave"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Search with Brave">

                        <ImageView
                            android:id="@+id/imgQuickEngineBrave"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_engine_brave" />
                    </FrameLayout>

                    <!-- Startpage -->
                    <FrameLayout
                        android:id="@+id/btnQuickEngineStartpage"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Search with Startpage">

                        <ImageView
                            android:id="@+id/imgQuickEngineStartpage"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_engine_startpage" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#24344D" />

            <LinearLayout
                android:id="@+id/layoutSuggestionsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Fullscreen Video Container -->
    <FrameLayout
        android:id="@+id/fullscreenContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />

</RelativeLayout>
