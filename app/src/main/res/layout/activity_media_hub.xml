<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <LinearLayout
        android:id="@+id/mainContentLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Firefox-Grade Floating Unified Browser Top Bar -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#0D111A"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <!-- Firefox Style Pill Search/URL Container -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_search_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <!-- Search Engine / Security Lock Indicator -->
                <ImageView
                    android:id="@+id/imgEngineIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_search"
                    app:tint="@color/fokk_cyan"
                    android:contentDescription="Search Engine" />

                <EditText
                    android:id="@+id/urlInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="4dp"
                    android:background="@null"
                    android:hint="Search or enter address"
                    android:imeOptions="actionGo"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="13sp" />

                <!-- Clear input button -->
                <ImageButton
                    android:id="@+id/btnClearUrl"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_close"
                    app:tint="@color/text_secondary"
                    android:visibility="gone"
                    android:contentDescription="Clear" />

                <!-- Voice Search Mic Button -->
                <ImageButton
                    android:id="@+id/btnVoiceSearch"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_mic"
                    app:tint="@color/text_secondary"
                    android:contentDescription="Voice Search" />

                <!-- Download Media Sniffer Button (visible when stream detected) -->
                <ImageButton
                    android:id="@+id/btnDownloadMedia"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_download"
                    app:tint="@color/fokk_cyan"
                    android:visibility="gone"
                    android:contentDescription="Download Media" />
            </LinearLayout>

            <!-- Tab Count Badge Button: [ 1 ] -->
            <FrameLayout
                android:id="@+id/btnNavTabs"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_tab_counter"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/textTabCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="1"
                    android:textColor="@color/fokk_cyan"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- Browser Menu Button (⋮) -->
            <ImageButton
                android:id="@+id/btnNavMenu"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_more_vert"
                app:tint="@color/text_primary"
                android:contentDescription="Browser Menu" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:max="100"
            android:progressTint="@color/fokk_cyan"
            android:visibility="gone" />

        <!-- Dynamic Multi-Tab Viewport Frame Container -->
        <FrameLayout
            android:id="@+id/tabContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Redundant Bottom Navigation Bar (Removed as per user request) -->
        <LinearLayout
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Top 10 Recent Browsing History Dropdown Overlay -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSuggestions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="58dp"
        android:visibility="gone"
        app:cardBackgroundColor="#131B2B"
        app:cardCornerRadius="18dp"
        app:cardElevation="16dp"
        app:strokeColor="#24344D"
        app:strokeWidth="1dp">

        <LinearLayout
            android:id="@+id/layoutSuggestionsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Fullscreen Video Container -->
    <FrameLayout
        android:id="@+id/fullscreenContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />

</RelativeLayout>