<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardTab"
    android:layout_width="match_parent"
    android:layout_height="170dp"
    android:layout_margin="4dp"
    app:cardBackgroundColor="#121212"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:strokeColor="#27272A"
    app:strokeWidth="1.2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Tab Card Header -->
        <LinearLayout
            android:id="@+id/layoutCardHeader"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:background="#18181B"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <ImageView
                android:id="@+id/imgTabIcon"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/ic_launch"
                app:tint="#FFFFFF" />

            <TextView
                android:id="@+id/textTabTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="New Tab"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnCloseTab"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                app:tint="#A1A1AA"
                android:contentDescription="Close Tab" />
        </LinearLayout>

        <!-- Tab Card Preview Body -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#0A0A0A"
            android:padding="8dp">

            <!-- Watermark / URL in Preview -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imgPreviewLogo"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:alpha="0.4"
                    android:src="@drawable/ic_shield_check"
                    app:tint="#FFFFFF" />

                <TextView
                    android:id="@+id/textTabUrl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:paddingHorizontal="8dp"
                    android:text="fokk://home"
                    android:textColor="#71717A"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <!-- Active Tab Indicator Badge -->
            <TextView
                android:id="@+id/badgeActiveTab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_stat_chip"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:text="ACTIVE"
                android:textColor="#FFFFFF"
                android:textSize="8.5sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Private Tab Badge -->
            <TextView
                android:id="@+id/badgePrivateTab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:background="#2E1644"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="GHOST"
                android:textColor="#D8B4FE"
                android:textSize="8sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
