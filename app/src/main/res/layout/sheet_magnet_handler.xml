<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0A0E18"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Handle drag indicator -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#1E293B" />

    <!-- Header: Icon + Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_download"
            app:tint="@color/fokk_cyan" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Torrent Link Detected"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="16dp"
        android:text="Stream video directly in Fokk or pass to an external client"
        android:textColor="@color/text_secondary"
        android:textSize="12.5sp" />

    <!-- Metadata Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="#121826"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeColor="#1E2A3E"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/textMagnetName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Torrent Name"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textMagnetHash"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="middle"
                android:fontFamily="monospace"
                android:singleLine="true"
                android:text="urn:btih:..."
                android:textColor="#A78BFA"
                android:textSize="11.5sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Action 1: Stream in Fokk (Primary) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStreamTorrent"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="10dp"
        android:backgroundTint="@color/fokk_purple"
        android:text="Stream In-Browser (WebTorrent)"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        app:cornerRadius="14dp"
        app:icon="@drawable/ic_launch"
        app:iconGravity="textStart"
        app:iconTint="@android:color/white" />

    <!-- Action 2: Open External Client -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOpenExternalTorrent"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="10dp"
        android:text="Open in External Torrent Client"
        android:textAllCaps="false"
        android:textColor="@color/text_primary"
        android:textSize="13.5sp"
        app:cornerRadius="14dp"
        app:strokeColor="#24344D" />

    <!-- Action 3: Copy Magnet URI -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCopyMagnet"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="Copy Magnet Link"
        android:textAllCaps="false"
        android:textColor="@color/fokk_cyan"
        android:textSize="13sp" />
</LinearLayout>
