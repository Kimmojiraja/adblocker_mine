<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0A0E18"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Modern cyber drag handle indicator -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="#1E293B" />

    <!-- Tab Search Bar to quickly find and filter open tabs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_search_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_search"
            app:tint="@color/text_secondary" />

        <EditText
            android:id="@+id/editSearchTabs"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="6dp"
            android:background="@null"
            android:hint="Search tabs by title or URL..."
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/btnClearTabSearch"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:visibility="gone"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <!-- Bespoke Cyber Obsidian Category Switcher (Tabs vs Ghost Mode) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginBottom="12dp"
        android:background="#121826"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="3dp">

        <TextView
            android:id="@+id/btnFilterNormal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_stat_chip"
            android:gravity="center"
            android:text="Tabs (1)"
            android:textColor="@color/fokk_cyan"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnFilterPrivate"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Ghost Mode (0)"
            android:textColor="@color/text_secondary"
            android:textSize="12.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Scrollable 2-column Tab Cards Grid -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="440dp">

        <LinearLayout
            android:id="@+id/layoutTabsGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </androidx.core.widget.NestedScrollView>

    <!-- Floating Obsidian Bottom Actions Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical">

        <!-- Left: Close All Tabs Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloseAllTabs"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="Close All"
            android:textColor="@color/text_secondary"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <!-- Middle: + Ghost Tab Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNewPrivateTab"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_toStartOf="@id/btnNewTabSheet"
            android:layout_centerVertical="true"
            android:layout_marginEnd="10dp"
            android:backgroundTint="#201533"
            android:text="+ Ghost Tab"
            android:textColor="#C084FC"
            android:textSize="12sp"
            android:textStyle="bold"
            app:cornerRadius="14dp" />

        <!-- Right: Modern Obsidian Glowing [+] New Tab Card Button -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnNewTabSheet"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="#7C6CF6"
            app:cardElevation="6dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_add"
                app:tint="#FFFFFF" />
        </com.google.android.material.card.MaterialCardView>
    </RelativeLayout>

</LinearLayout>
